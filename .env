# ===========================================
# Open Claude Code - Environment Variables
# ===========================================
# Copy this file to .env and uncomment/modify values as needed.
# Only uncommented variables are active.

# -------------------------------------------
# Privacy & Telemetry
# -------------------------------------------

# Disable all telemetry
DISABLE_TELEMETRY=1

# Disable non-essential network traffic (extra model checks, update checks, etc.)
CLAUDE_CODE_DISABLE_NONESSENTIAL_TRAFFIC=1

# -------------------------------------------
# Provider Selection (uncomment one)
# -------------------------------------------

# Use AWS Bedrock as the AI provider
# CLAUDE_CODE_USE_BEDROCK=1

# Use Google Vertex AI as the AI provider
# CLAUDE_CODE_USE_VERTEX=1

# Use Google Cloud Foundry as the AI provider
# CLAUDE_CODE_USE_FOUNDRY=1

# Use Z.ai as the AI provider
# CLAUDE_CODE_USE_ZAI=1

# Skip authentication for Bedrock (use IAM role)
# CLAUDE_CODE_SKIP_BEDROCK_AUTH=1

# Skip authentication for Vertex (use default credentials)
# CLAUDE_CODE_SKIP_VERTEX_AUTH=1

# Skip authentication for Foundry
# CLAUDE_CODE_SKIP_FOUNDRY_AUTH=1

# -------------------------------------------
# Authentication
# -------------------------------------------

# OAuth access token (alternative to interactive login)
# CLAUDE_CODE_OAUTH_TOKEN=your_token_here

# API key via file descriptor (for secure credential management)
# CLAUDE_CODE_API_KEY_FILE_DESCRIPTOR=3

# -------------------------------------------
# UI & Terminal
# -------------------------------------------

# Enable fullscreen/alt-screen mode (prevents screen flicker on updates)
# CLAUDE_CODE_NO_FLICKER=1

# Disable mouse tracking in fullscreen (keyboard scroll still works)
# CLAUDE_CODE_DISABLE_MOUSE=1

# Disable mouse clicks in fullscreen (wheel and keyboard still work)
# CLAUDE_CODE_DISABLE_MOUSE_CLICKS=1

# Disable syntax highlighting in diff output
# CLAUDE_CODE_SYNTAX_HIGHLIGHT=0

# -------------------------------------------
# Effort & Model Behavior
# -------------------------------------------

# Set global effort level: low, medium, high, max
# CLAUDE_CODE_EFFORT_LEVEL=max

# Always enable the effort parameter for all models (even unsupported ones)
# CLAUDE_CODE_ALWAYS_ENABLE_EFFORT=1

# Disable legacy model name remapping (use model names as-is)
# CLAUDE_CODE_DISABLE_LEGACY_MODEL_REMAP=1

# -------------------------------------------
# Context & Compaction
# -------------------------------------------

# Set custom effective context window size in tokens
# CLAUDE_CODE_AUTO_COMPACT_WINDOW=150000

# Override the blocking limit (use with caution)
# CLAUDE_CODE_BLOCKING_LIMIT_OVERRIDE=200000

# -------------------------------------------
# Plan Mode
# -------------------------------------------

# Set number of agents in plan mode
# CLAUDE_CODE_PLAN_V2_AGENT_COUNT=3

# Set number of explore agents in plan mode
# CLAUDE_CODE_PLAN_V2_EXPLORE_AGENT_COUNT=2

# -------------------------------------------
# Security & Safety
# -------------------------------------------

# Force undercover mode (prevents leaking internal info in public repos)
CLAUDE_CODE_UNDERCOVER=1

# Enable additional protection layers
CLAUDE_CODE_ADDITIONAL_PROTECTION=1

# -------------------------------------------
# Remote & Container
# -------------------------------------------

# Enable remote session mode
# CLAUDE_CODE_REMOTE=1

# Container ID for containerized sessions
# CLAUDE_CODE_CONTAINER_ID=your_container_id

# Remote session ID for reconnecting
# CLAUDE_CODE_REMOTE_SESSION_ID=your_session_id

# -------------------------------------------
# Shell & Commands
# -------------------------------------------

# Prefix for all shell commands (e.g., wrapper scripts, proxies)
# CLAUDE_CODE_SHELL_PREFIX=

# Force PowerShell tool usage on Windows
# CLAUDE_CODE_USE_POWERSHELL_TOOL=1

# -------------------------------------------
# Plugins & Cache
# -------------------------------------------

# Use zip cache for plugins (faster installs)
# CLAUDE_CODE_PLUGIN_USE_ZIP_CACHE=1

# Custom plugin cache directory
# CLAUDE_CODE_PLUGIN_CACHE_DIR=/path/to/cache

# -------------------------------------------
# Debug & Diagnostics
# -------------------------------------------

# Enable performance tracing (outputs perfetto trace)
# CLAUDE_CODE_PERFETTO_TRACE=1

# Enable telemetry (overrides DISABLE_TELEMETRY)
# CLAUDE_CODE_ENABLE_TELEMETRY=1

# Enable enhanced telemetry beta
# CLAUDE_CODE_ENHANCED_TELEMETRY_BETA=1

# -------------------------------------------
# Claude in Chrome
# -------------------------------------------

# Enable Claude in Chrome browser integration
# CLAUDE_CODE_ENABLE_CFC=1
